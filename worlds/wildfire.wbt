#VRML_SIM R2023b utf8

WorldInfo {
  title "FireHawk Wildfire Spotter Drone"
  info [
    "FireHawk Mk1: custom quadcopter that patrols a forest area,"
    "detects a wildfire with its onboard camera, hovers to confirm,"
    "reports the fire GPS position and returns to base."
  ]
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
